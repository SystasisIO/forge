if(NOT COMPILER OR NOT WASM_C_COMPILER OR NOT MALFORMED_FIXTURE OR NOT WORK)
   message(FATAL_ERROR "Expected COMPILER, WASM_C_COMPILER, MALFORMED_FIXTURE and scoped WORK paths")
endif()
file(MAKE_DIRECTORY "${WORK}")
get_filename_component(_compiler_directory "${WASM_C_COMPILER}" DIRECTORY)
if(NOT WASM_LD)
   find_program(WASM_LD NAMES wasm-ld HINTS "${_compiler_directory}" REQUIRED)
endif()
execute_process(COMMAND "${WASM_C_COMPILER}" --target=wasm32 -O1 -nostdlib
   "-fuse-ld=${WASM_LD}" -Wl,--no-entry -Wl,--export=add
   "${CMAKE_CURRENT_LIST_DIR}/fixture.c" -o "${WORK}/valid.wasm"
   WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(NOT "${_result}" STREQUAL "0")
   message(FATAL_ERROR "Fixture generation failed (${_result}): ${_out}${_err}")
endif()
file(WRITE "${WORK}/invalid.wasm" "not wasm")
execute_process(COMMAND "${MALFORMED_FIXTURE}" "${WORK}/parser-invalid.wasm"
   RESULT_VARIABLE _result)
if(NOT "${_result}" STREQUAL "0")
   message(FATAL_ERROR "Malformed fixture generation failed (${_result})")
endif()
cmake_host_system_information(RESULT _host QUERY OS_PLATFORM)
if(_host MATCHES "^(arm64|aarch64)$")
   set(_target aarch64)
elseif(_host MATCHES "^(x86_64|amd64|AMD64)$")
   set(_target x86_64)
else()
   message(FATAL_ERROR "No qualified CLI target for ${_host}")
endif()
set(_flags "--target=${_target}" --cpu=generic --bounds-checks=1 --stack-bounds-checks=1
   --disable-simd --disable-bulk-memory --disable-ref-types --enable-multi-thread)
function(run_cli expected name input output)
   execute_process(COMMAND "${COMPILER}" ${_flags} -o "${output}" "${input}"
      WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err
      TIMEOUT 15)
   file(WRITE "${WORK}/${name}.log" "exit=${_result}\n${_out}${_err}")
   if(expected STREQUAL "success")
      if(NOT "${_result}" STREQUAL "0" OR NOT EXISTS "${output}")
         message(FATAL_ERROR "${name} failed (${_result}): ${_out}${_err}")
      endif()
      file(READ "${output}" _magic LIMIT 8 HEX)
      if(NOT _magic STREQUAL "00616f7406000000")
         message(FATAL_ERROR "${name} did not emit an AOT v6 module: ${_magic}")
      endif()
      file(SHA256 "${output}" _digest)
      if(DEFINED _reference AND NOT _digest STREQUAL _reference)
         message(FATAL_ERROR "${name} emitted nondeterministic AOT bytes")
      endif()
      set(_reference "${_digest}" PARENT_SCOPE)
   else()
      # A signal/timeout is not a successful rejection (nor is exit 139).
      if(NOT "${_result}" MATCHES "^(1|255)$")
         message(FATAL_ERROR "${name} did not reject normally (${_result}): ${_out}${_err}")
      endif()
      if(EXISTS "${output}" AND NOT IS_DIRECTORY "${output}")
         message(FATAL_ERROR "${name} unexpectedly created an output file")
      endif()
   endif()
endfunction()
foreach(_iteration RANGE 1 8)
   run_cli(rejection "invalid-${_iteration}" "${WORK}/invalid.wasm" "${WORK}/invalid-${_iteration}.aot")
   run_cli(rejection "parser-invalid-${_iteration}" "${WORK}/parser-invalid.wasm" "${WORK}/parser-invalid-${_iteration}.aot")
   run_cli(success "valid-${_iteration}" "${WORK}/valid.wasm" "${WORK}/valid-${_iteration}.aot")
   run_cli(rejection "missing-${_iteration}" "${WORK}/missing.wasm" "${WORK}/missing-${_iteration}.aot")
   run_cli(rejection "output-${_iteration}" "${WORK}/valid.wasm" "${WORK}")
   run_cli(success "recovery-${_iteration}" "${WORK}/valid.wasm" "${WORK}/recovery-${_iteration}.aot")
endforeach()
message(STATUS "PASS 16 real CLI compilations and 32 normal failures, deterministic recovery")
