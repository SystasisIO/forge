function(read_definitions commands suffix output)
   file(READ "${commands}" _commands)
   string(JSON _count LENGTH "${_commands}")
   math(EXPR _last "${_count} - 1")
   set(_found FALSE)
   foreach(_index RANGE 0 ${_last})
      string(JSON _file GET "${_commands}" ${_index} file)
      if(_file MATCHES "${suffix}$")
         if(_found)
            message(FATAL_ERROR "Ambiguous translation unit: ${suffix}")
         endif()
         string(JSON _command GET "${_commands}" ${_index} command)
         separate_arguments(_arguments UNIX_COMMAND "${_command}")
         list(FILTER _arguments INCLUDE REGEX "^-DWASM_")
         list(SORT _arguments)
         set(_found TRUE)
         set(${output} "${_arguments}" PARENT_SCOPE)
      endif()
   endforeach()
   if(NOT _found)
      message(FATAL_ERROR "Missing translation unit: ${suffix}")
   endif()
endfunction()
read_definitions("${CLI_COMMANDS}" "${CLI_MAIN}" _cli)
foreach(_unit IN ITEMS core/iwasm/common/wasm_memory.c core/iwasm/compilation/aot_emit_aot_file.c)
   read_definitions("${CLI_COMMANDS}" "${_unit}" _definitions)
   if(NOT _definitions STREQUAL _cli)
      message(FATAL_ERROR "CLI and ${_unit} feature definitions differ")
   endif()
endforeach()
if(LIBRARY_COMMANDS)
   read_definitions("${LIBRARY_COMMANDS}" "engine_compiler.cpp" _library)
   if(NOT _library STREQUAL _cli)
      message(FATAL_ERROR "CLI and library compiler feature definitions differ")
   endif()
endif()
list(LENGTH _cli _count)
message(STATUS "PASS ${_count} explicit WAMR definitions agree: ${_cli}")
