cmake_minimum_required(VERSION 3.31)

foreach(required IN ITEMS PROBE COMPILER SOURCE_IDENTITY ROOT WORK)
   if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "Missing profile test input: ${required}")
   endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=${COMPILER}"
   "-DSOURCE_IDENTITY=${SOURCE_IDENTITY}" -P "${ROOT}/cmake/ForgeWamrCompilerIdentity.cmake"
   COMMAND_ERROR_IS_FATAL ANY)

# Never replace earlier artifacts, including when CTest repeats this test.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run)
set(directory "${WORK}/${run}")
file(MAKE_DIRECTORY "${directory}")
execute_process(COMMAND "${PROBE}" --fixtures "${directory}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${PROBE}" --memory-profile "${directory}"
   COMMAND_ERROR_IS_FATAL ANY TIMEOUT 10)

# Compare source admission without instantiating or allocating the declared memory.
foreach(fixture IN ITEMS memory-zero memory-cap memory-declared-max memory-no-max)
   set(source "${directory}/${fixture}.wasm")
   set(artifact "${directory}/${fixture}.aot")
   file(SHA256 "${source}" original)
   execute_process(COMMAND "${COMPILER}" "${source}" "${artifact}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
   if(NOT result STREQUAL "0" OR NOT EXISTS "${artifact}")
      message(FATAL_ERROR "Healthy ${fixture} source compilation failed: ${result}: ${output}${error}")
   endif()
   file(SHA256 "${source}" unchanged)
   if(NOT original STREQUAL unchanged)
      message(FATAL_ERROR "Compiler changed ${fixture} source WASM")
   endif()
endforeach()

foreach(budget IN ITEMS 8192 16384)
   set(source "${directory}/boundary-${budget}.wasm")
   set(artifact "${directory}/boundary-${budget}.aot")
   file(SHA256 "${source}" original)
   execute_process(COMMAND "${COMPILER}" "${source}" "${artifact}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
   if(NOT result STREQUAL "0" OR NOT EXISTS "${artifact}")
      message(FATAL_ERROR "Healthy ${budget}-byte AOT control failed: ${result}: ${output}${error}")
   endif()
   file(SHA256 "${source}" unchanged)
   if(NOT original STREQUAL unchanged)
      message(FATAL_ERROR "Compiler changed original WASM bytes")
   endif()
   execute_process(COMMAND "${PROBE}" --boundary "${source}" "${artifact}" "${budget}"
      COMMAND_ERROR_IS_FATAL ANY TIMEOUT 10)
endforeach()

set(source "${directory}/profile-cap.wasm")
set(artifact "${directory}/profile-cap.aot")
file(SHA256 "${source}" original)
execute_process(COMMAND "${COMPILER}" "${source}" "${artifact}"
   RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "0" OR NOT EXISTS "${artifact}")
   message(FATAL_ERROR "Combined-profile-cap AOT control failed: ${result}: ${output}${error}")
endif()
file(SHA256 "${source}" unchanged)
if(NOT original STREQUAL unchanged)
   message(FATAL_ERROR "Compiler changed profile-cap source WASM")
endif()
execute_process(COMMAND "${PROBE}" --profile "${source}" "${artifact}"
   COMMAND_ERROR_IS_FATAL ANY TIMEOUT 10)
foreach(fixture IN ITEMS capacity profile-over memory-over)
   set(source "${directory}/${fixture}.wasm")
   set(artifact "${directory}/${fixture}.aot")
   file(SHA256 "${source}" original)
   execute_process(COMMAND "${COMPILER}" "${source}" "${artifact}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
   if(NOT result STREQUAL "1" OR EXISTS "${artifact}")
      message(FATAL_ERROR "Expected clean ${fixture} admission refusal without artifact: ${result}: ${output}${error}")
   endif()
   if(fixture STREQUAL "capacity")
      set(expected "FAIL WASM compiler rejected the module")
   else()
      set(expected "FAIL WASM module exceeds its admission limit")
   endif()
   string(FIND "${error}" "${expected}" refusal)
   if(refusal EQUAL -1)
      message(FATAL_ERROR "Compiler failed outside the ${fixture} refusal path: ${output}${error}")
   endif()
   file(SHA256 "${source}" unchanged)
   if(NOT original STREQUAL unchanged)
      message(FATAL_ERROR "Compiler rejection changed original WASM bytes")
   endif()
endforeach()
message(STATUS "PASS equal initial-page/65536-local/profile-over source admission, 8/16 KiB budgets and combined-profile-cap AOT control; not full public integration or large-memory allocation")
