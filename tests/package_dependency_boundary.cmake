# Installed exports may declare unrelated targets. Audit only reachable link and
# module dependencies, including targets inside LINK_ONLY/config expressions.
function(forge_package_assert_dependency_boundary root forbidden)
   set(pending "${root}")
   set(visited)
   while(NOT "${pending}" STREQUAL "")
      list(POP_FRONT pending current)
      if("${current}" IN_LIST visited OR NOT TARGET "${current}")
         continue()
      endif()
      list(APPEND visited "${current}")
      if("${current}" MATCHES "${forbidden}")
         message(FATAL_ERROR "Forbidden dependency of ${root}: ${current}")
      endif()
      foreach(property IN ITEMS INTERFACE_LINK_LIBRARIES IMPORTED_CXX_MODULES_LINK_LIBRARIES)
         get_target_property(dependencies "${current}" "${property}")
         if(NOT dependencies)
            continue()
         endif()
         string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_.+-]*(::[A-Za-z0-9_.+-]+)*"
            targets "${dependencies}")
         list(APPEND pending ${targets})
      endforeach()
   endwhile()
endfunction()
