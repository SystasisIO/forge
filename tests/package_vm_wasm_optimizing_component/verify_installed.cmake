cmake_minimum_required(VERSION 3.31)

foreach(_required IN ITEMS SOURCE_ROOT BUILD_ROOT CONSUMER_CACHE GENERATOR CXX_COMPILER
      CTEST_COMMAND HELPER AS_BYTES)
   if(NOT DEFINED FORGE_PACKAGE_TEST_${_required} OR "${FORGE_PACKAGE_TEST_${_required}}" STREQUAL "")
      message(FATAL_ERROR "FORGE_PACKAGE_TEST_${_required} is required")
   endif()
endforeach()

set(_configure "${CMAKE_COMMAND}" --fresh
   -S "${FORGE_PACKAGE_TEST_SOURCE_ROOT}/tests/package_vm_wasm_optimizing_component"
   -B "${FORGE_PACKAGE_TEST_BUILD_ROOT}"
   -G "${FORGE_PACKAGE_TEST_GENERATOR}"
   "-C${FORGE_PACKAGE_TEST_CONSUMER_CACHE}"
   "-DCMAKE_CXX_COMPILER=${FORGE_PACKAGE_TEST_CXX_COMPILER}"
   -DCMAKE_DISABLE_FIND_PACKAGE_Clang=ON
   -DCMAKE_DISABLE_FIND_PACKAGE_LLVM=OFF
   -DFORGE_PACKAGE_OPTIMIZING_BUILD_PRODUCER=ON
   -DFORGE_PACKAGE_OPTIMIZING_BUILD_SESSION=ON
   "-DFORGE_PACKAGE_OPTIMIZING_HELPER=${FORGE_PACKAGE_TEST_HELPER}"
   "-DFORGE_WAMR_COMPILER_TEST_AS_BYTES=${FORGE_PACKAGE_TEST_AS_BYTES}")
foreach(_optional IN ITEMS C_COMPILER OSX_SYSROOT BUILD_TYPE)
   if(DEFINED FORGE_PACKAGE_TEST_${_optional} AND NOT "${FORGE_PACKAGE_TEST_${_optional}}" STREQUAL "")
      list(APPEND _configure "-DCMAKE_${_optional}=${FORGE_PACKAGE_TEST_${_optional}}")
   endif()
endforeach()
if(DEFINED FORGE_PACKAGE_TEST_LLVM_DIR AND NOT "${FORGE_PACKAGE_TEST_LLVM_DIR}" STREQUAL "")
   list(APPEND _configure "-DLLVM_DIR=${FORGE_PACKAGE_TEST_LLVM_DIR}")
endif()

execute_process(COMMAND ${_configure} COMMAND_ECHO STDOUT
   COMMAND_ERROR_IS_FATAL ANY TIMEOUT 300)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${FORGE_PACKAGE_TEST_BUILD_ROOT}" --parallel 2
   COMMAND_ECHO STDOUT COMMAND_ERROR_IS_FATAL ANY TIMEOUT 1800)
execute_process(COMMAND "${FORGE_PACKAGE_TEST_CTEST_COMMAND}"
   --test-dir "${FORGE_PACKAGE_TEST_BUILD_ROOT}" --parallel 1 --output-on-failure --no-tests=error
   --output-log "${FORGE_PACKAGE_TEST_BUILD_ROOT}/package-tests.log"
   --output-junit "${FORGE_PACKAGE_TEST_BUILD_ROOT}/package-tests.xml"
   COMMAND_ECHO STDOUT COMMAND_ERROR_IS_FATAL ANY TIMEOUT 1500)
