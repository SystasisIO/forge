@PACKAGE_INIT@

set(ForgeContract_VERSION "@PROJECT_VERSION@")
set(ForgeContract_PROFILE "@FORGE_CONTRACT_PROFILE@")
set(ForgeContract_REPRODUCIBLE "@FORGE_CONTRACT_REPRODUCIBLE@")
set(ForgeContract_LLVM_VERSION "@FORGE_CONTRACT_MANIFEST_LLVM_VERSION@")
set(ForgeContract_LLVM_COMMIT "@FORGE_CONTRACT_MANIFEST_LLVM_COMMIT@")
set(ForgeContract_SYSROOT_SCHEMA_VERSION "@FORGE_CONTRACT_SYSROOT_SCHEMA_VERSION@")
set(ForgeContract_INTRINSIC_VERSION "@FORGE_CONTRACT_INTRINSIC_VERSION@")

include("${CMAKE_CURRENT_LIST_DIR}/ForgeContractPaths.cmake")
set(ForgeContract_CLANG "${ForgeContract_PREFIX}/bin/clang++")
set(ForgeContract_WASM_LD "${ForgeContract_PREFIX}/bin/wasm-ld")
set(ForgeContract_SYSROOT "${ForgeContract_PREFIX}/sysroot")
set(ForgeContract_DATA_DIR "${ForgeContract_PREFIX}/@CMAKE_INSTALL_DATADIR@/forge-contract")
file(READ "${ForgeContract_DATA_DIR}/sysroot.sha256" ForgeContract_SYSROOT_HASH)
string(STRIP "${ForgeContract_SYSROOT_HASH}" ForgeContract_SYSROOT_HASH)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
   "${ForgeContract_DATA_DIR}/sysroot.sha256"
   "${ForgeContract_DATA_DIR}/foundation.json"
)
set(ForgeContract_ABIGEN "${ForgeContract_PREFIX}/bin/abigen")
set(ForgeContract_ATTR_PLUGIN "${ForgeContract_PREFIX}/@CMAKE_INSTALL_LIBDIR@/forge-contract/attr-plugin@CMAKE_SHARED_MODULE_SUFFIX@")
set(ForgeContract_CHECK "${ForgeContract_PREFIX}/bin/contract-check")
set(ForgeContract_MANIFEST "${ForgeContract_PREFIX}/bin/contract-manifest")
set(ForgeContract_COMPONENTS "${CMAKE_CURRENT_LIST_DIR}/ForgeContractGuestComponents.cmake")
set(ForgeContract_BUILD "${CMAKE_CURRENT_LIST_DIR}/ForgeContractBuild.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/ForgeContractFunctions.cmake")

foreach(_required
   ForgeContract_CLANG
   ForgeContract_WASM_LD
   ForgeContract_SYSROOT
   ForgeContract_DATA_DIR
   ForgeContract_ABIGEN
   ForgeContract_ATTR_PLUGIN
   ForgeContract_CHECK
   ForgeContract_MANIFEST
   ForgeContract_COMPONENTS
   ForgeContract_BUILD
)
   if(NOT EXISTS "${${_required}}")
      set(ForgeContract_FOUND FALSE)
      set(ForgeContract_NOT_FOUND_MESSAGE "Forge Contract SDK is incomplete: ${${_required}} does not exist")
      return()
   endif()
endforeach()

file(REAL_PATH "${ForgeContract_COMPONENTS}" _forge_contract_components_file)
get_property(
   _forge_contract_registered_components_file
   GLOBAL PROPERTY FORGE_CONTRACT_REGISTERED_COMPONENTS_FILE
)
if(_forge_contract_registered_components_file)
   if(NOT _forge_contract_registered_components_file STREQUAL _forge_contract_components_file)
      set(ForgeContract_FOUND FALSE)
      set(
         ForgeContract_NOT_FOUND_MESSAGE
         "a different Forge Contract component registry is already loaded: ${_forge_contract_registered_components_file}"
      )
      return()
   endif()
else()
   include("${_forge_contract_components_file}")
   _forge_contract_finalize_guest_components()
   set_property(
      GLOBAL PROPERTY FORGE_CONTRACT_REGISTERED_COMPONENTS_FILE
      "${_forge_contract_components_file}"
   )
endif()

set(_forge_contract_foundation_manifest "${ForgeContract_DATA_DIR}/foundation.json")
if(NOT EXISTS "${_forge_contract_foundation_manifest}")
   set(ForgeContract_FOUND FALSE)
   set(ForgeContract_NOT_FOUND_MESSAGE "Forge Contract SDK is missing its foundation manifest")
   return()
endif()
file(READ "${_forge_contract_foundation_manifest}" _forge_contract_foundation_json)
string(JSON _forge_contract_foundation_version GET "${_forge_contract_foundation_json}" version)
if(NOT "${_forge_contract_foundation_version}" STREQUAL "1")
   set(ForgeContract_FOUND FALSE)
   set(ForgeContract_NOT_FOUND_MESSAGE "unsupported Forge Contract foundation manifest version")
   return()
endif()
string(JSON _forge_contract_archive_count LENGTH "${_forge_contract_foundation_json}" archives)
math(EXPR _forge_contract_archive_last "${_forge_contract_archive_count} - 1")
foreach(_forge_contract_archive_index RANGE 0 ${_forge_contract_archive_last})
   string(
      JSON _forge_contract_archive_name
      GET "${_forge_contract_foundation_json}" archives ${_forge_contract_archive_index} name
   )
   string(
      JSON _forge_contract_archive_sha256
      GET "${_forge_contract_foundation_json}" archives ${_forge_contract_archive_index} sha256
   )
   set(_forge_contract_archive "${ForgeContract_SYSROOT}/lib/${_forge_contract_archive_name}")
   if(NOT EXISTS "${_forge_contract_archive}")
      set(ForgeContract_FOUND FALSE)
      set(ForgeContract_NOT_FOUND_MESSAGE "Forge Contract SDK is missing ${_forge_contract_archive_name}")
      return()
   endif()
   file(SHA256 "${_forge_contract_archive}" _forge_contract_actual_sha256)
   if(NOT "${_forge_contract_actual_sha256}" STREQUAL "${_forge_contract_archive_sha256}")
      set(ForgeContract_FOUND FALSE)
      set(ForgeContract_NOT_FOUND_MESSAGE "Forge Contract SDK archive checksum failed: ${_forge_contract_archive_name}")
      return()
   endif()
endforeach()
