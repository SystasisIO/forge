include_guard(GLOBAL)

function(forge_prepare_wamr output_source output_identity)
   find_package(Git REQUIRED)
   get_filename_component(_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
   set(_vendor "${_root}/vendor/wamr")
   set(_revision "aed18d79539ac608077caad6be41021ffc927aad")
   execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_vendor}" rev-parse HEAD
      OUTPUT_VARIABLE _head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
   execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_vendor}" status --porcelain
      OUTPUT_VARIABLE _dirty OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
   if(NOT _head STREQUAL _revision OR NOT _dirty STREQUAL "")
      message(FATAL_ERROR "WAMR requires the clean, pinned vendor revision ${_revision}")
   endif()
   set(_profile "${_root}/cmake/ForgeWamrProfile.cmake")
   file(SHA256 "${_profile}" _profile_digest)
   set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_profile}")
   # Sibling leaves do not inherit the runtime directory's CMake variables.
   # AOT artifact/compiler identity always names the shared JIT-disabled role.
   set(_effective_profile "${_profile_digest};jit=0;fast-jit=0;lazy-jit=0")
   if(ARGC GREATER 2)
      if(NOT ARGV2 STREQUAL "jit" OR NOT WAMR_BUILD_JIT EQUAL 1
         OR NOT WAMR_BUILD_FAST_JIT EQUAL 0 OR NOT WAMR_BUILD_LAZY_JIT EQUAL 0)
         message(FATAL_ERROR "Unknown or inconsistent Forge WAMR runtime identity role")
      endif()
      if(NOT LLVM_PACKAGE_VERSION STREQUAL "22.1.8")
         message(FATAL_ERROR "Resolve the qualified LLVM package before preparing the JIT runtime")
      endif()
      set(_effective_profile "${_profile_digest};jit=1;fast-jit=0;lazy-jit=0")
      string(APPEND _effective_profile ";llvm=${LLVM_PACKAGE_VERSION};target=${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR};cpu=native;opt=3;size=3;code-model=large;reloc=pic;codegen=aggressive;bounds=explicit;threads=caller")
   endif()
   string(SHA256 _effective_profile_digest "${_effective_profile}")
   set(_identity "${_revision}-${_effective_profile_digest}")
   set(_prepared "${CMAKE_BINARY_DIR}/_deps/wamr-${_identity}")
   if(NOT EXISTS "${_prepared}/.forge-prepared")
      if(EXISTS "${_prepared}")
         message(FATAL_ERROR "Incomplete WAMR preparation at ${_prepared}; use a fresh build directory")
      endif()
      file(MAKE_DIRECTORY "${_prepared}")
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_vendor}" archive
         --format=tar "--output=${_prepared}/source.tar" "${_revision}"
         COMMAND_ERROR_IS_FATAL ANY)
      file(ARCHIVE_EXTRACT INPUT "${_prepared}/source.tar" DESTINATION "${_prepared}")
      file(REMOVE "${_prepared}/source.tar")
      file(WRITE "${_prepared}/.forge-prepared" "${_identity}\n")
   endif()
   set(${output_source} "${_prepared}" PARENT_SCOPE)
   set(${output_identity} "${_identity}" PARENT_SCOPE)
endfunction()
