if(NOT EXISTS "${COMPILER}" OR NOT DEFINED SOURCE_IDENTITY)
   message(FATAL_ERROR "A compiler binary and prepared source identity are required")
endif()
file(REAL_PATH "${COMPILER}" COMPILER)
file(SHA256 "${COMPILER}" _binary_digest)
set(_expected "${SOURCE_IDENTITY}\n${_binary_digest}\n")
if(WRITE_IDENTITY)
   file(WRITE "${COMPILER}.forge-identity" "${_expected}")
else()
   if(NOT EXISTS "${COMPILER}.forge-identity")
      message(FATAL_ERROR "Build wamrc with tests/vm_wamr/compiler; compiler identity is missing")
   endif()
   file(READ "${COMPILER}.forge-identity" _actual)
   if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "wamrc does not match this patched WAMR profile or its recorded binary digest")
   endif()
endif()
