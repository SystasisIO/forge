load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_static_library.bzl", "cc_static_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Upstream owns every source, proto-generation and dependency edge below these
# public CEL entry points. This package owns only the private Forge adapter.
cc_library(
    name = "backend",
    srcs = ["libraries/expression/backend.cpp", "libraries/expression/arithmetic.cpp"],
    hdrs = glob(["libraries/expression/details/*.hxx"]),
    deps = [
        "//checker:checker_options",
        "//checker:standard_library",
        "//checker:type_checker_builder_factory",
        "//checker:type_checker_builder",
        "//checker:type_checker_subset_factory",
        "//common:ast",
        "//common:ast_traverse",
        "//common:ast_visitor",
        "//common:ast_visitor_base",
        "//common:decl",
        "//common:expr",
        "//common:minimal_descriptor_pool",
        "//common:standard_definitions",
        "//common:type",
        "//common:value",
        "//internal:utf8",
        "//parser:pratt_parser",
        "//runtime:activation",
        "//runtime:function_adapter",
        "//runtime:function_registry",
        "//runtime:runtime",
        "//runtime:reference_resolver",
        "//runtime:runtime_options",
        "//runtime:standard_runtime_builder_factory",
        "@com_google_absl//absl/log:initialize",
        "@com_google_absl//absl/synchronization",
        "@com_google_protobuf//:protobuf",
    ],
)

cc_test(
    name = "arithmetic_test",
    srcs = ["tests/expression_arithmetic.cpp", "tests/expression_arithmetic_cases.inc"],
    deps = [":backend"],
)

cc_static_library(
    name = "archive",
    deps = [":backend"],
)
