set(WAMR_BUILD_FAST_INTERP 0)

function(forge_wamr_apply_profile directory role)
   if(role STREQUAL "runtime")
      set(_compiler 0)
      set(_jit ${WAMR_BUILD_JIT})
   elseif(role STREQUAL "compiler")
      set(_compiler 1)
      set(_jit 0)
   else()
      message(FATAL_ERROR "Unknown Forge WAMR role: ${role}")
   endif()
   # Production uses classic in both processes. Standalone qualification may
   # select fast explicitly before upstream source selection and this call.
   if(WAMR_BUILD_FAST_INTERP)
      set(_fast 1)
   else()
      set(_fast 0)
   endif()
   set(_profile ${_forge_wamr_profile_definitions}
      "WASM_ENABLE_FAST_INTERP=${_fast}" "WASM_ENABLE_WAMR_COMPILER=${_compiler}")
   list(FILTER _profile EXCLUDE REGEX "^WASM_ENABLE_JIT=")
   list(APPEND _profile "WASM_ENABLE_JIT=${_jit}")
   get_directory_property(_definitions DIRECTORY "${directory}" COMPILE_DEFINITIONS)
   foreach(_definition IN LISTS _profile)
      string(REGEX REPLACE "=.*$" "" _name "${_definition}")
      list(FILTER _definitions EXCLUDE REGEX "^${_name}(=|$)")
   endforeach()
   set_property(DIRECTORY "${directory}" PROPERTY COMPILE_DEFINITIONS ${_definitions} ${_profile})
endfunction()
