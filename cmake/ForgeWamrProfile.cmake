# Include before upstream source selection; apply after upstream directory flags.
# ForgeWamrSource hashes this file into the compiler/artifact identity.
set(_forge_wamr_profile_definitions)
macro(_forge_wamr_profile_bool build_variable definition value)
   if(${value})
      set(${build_variable} 1)
   else()
      set(${build_variable} 0)
   endif()
   list(APPEND _forge_wamr_profile_definitions "${definition}=${${build_variable}}")
endmacro()

macro(_forge_wamr_profile_feature feature value)
   _forge_wamr_profile_bool(WAMR_BUILD_${feature} WASM_ENABLE_${feature} ${value})
endmacro()

_forge_wamr_profile_feature(INTERP ON)
