diff --git a/core/iwasm/common/wasm_canonical_nan.h b/core/iwasm/common/wasm_canonical_nan.h
new file mode 100644
index 0000000..921aeb2
--- /dev/null
+++ b/core/iwasm/common/wasm_canonical_nan.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception */
+#ifndef WASM_CANONICAL_NAN_H
+#define WASM_CANONICAL_NAN_H
+
+/* Arithmetic results only. Bitwise operations and transport preserve payloads. */
+static inline float
+wasm_canonical_F32(float value)
+{
+    union { float value; uint32 bits; } result = { .value = value };
+    if ((result.bits & 0x7fffffffU) > 0x7f800000U)
+        result.bits = 0x7fc00000U;
+    return result.value;
+}
+
+static inline double
+wasm_canonical_F64(double value)
+{
+    union { double value; uint64 bits; } result = { .value = value };
+    if ((result.bits & 0x7fffffffffffffffULL) > 0x7ff0000000000000ULL)
+        result.bits = 0x7ff8000000000000ULL;
+    return result.value;
+}
+#endif
diff --git a/core/iwasm/common/wasm_fp_environment.h b/core/iwasm/common/wasm_fp_environment.h
new file mode 100644
index 0000000..6fabf41
--- /dev/null
+++ b/core/iwasm/common/wasm_fp_environment.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception */
+#ifndef WASM_FP_ENVIRONMENT_H
+#define WASM_FP_ENVIRONMENT_H
+#include <fenv.h>
+#if defined(__x86_64__)
+#include <xmmintrin.h>
+#elif !defined(__aarch64__) && !defined(__arm64__)
+#error "The deterministic FP profile needs a qualified host FP environment"
+#endif
+
+typedef struct WASMFPEnvironment {
+    fenv_t saved;
+#if defined(__x86_64__)
+    unsigned int control;
+#else
+    unsigned long long control;
+    unsigned long long status;
+#endif
+} WASMFPEnvironment;
+
+static inline bool
+wasm_fp_leave(const WASMFPEnvironment *env)
+{
+    bool ok = fesetenv(&env->saved) == 0;
+#if defined(__x86_64__)
+    _mm_setcsr(env->control);
+#else
+    __asm__ volatile("msr fpcr, %0" : : "r"(env->control) : "memory");
+    __asm__ volatile("msr fpsr, %0" : : "r"(env->status) : "memory");
+#endif
+    return ok;
+}
+
+static inline bool
+wasm_fp_enter(WASMFPEnvironment *env)
+{
+    if (fegetenv(&env->saved) != 0)
+        return false;
+#if defined(__x86_64__)
+    env->control = _mm_getcsr();
+#else
+    __asm__ volatile("mrs %0, fpcr" : "=r"(env->control));
+    __asm__ volatile("mrs %0, fpsr" : "=r"(env->status));
+#endif
+    if (fesetenv(FE_DFL_ENV) != 0 || fesetround(FE_TONEAREST) != 0) {
+        wasm_fp_leave(env);
+        return false;
+    }
+    /* Disable host traps, flush-to-zero and nonstandard rounding modes. */
+#if defined(__x86_64__)
+    _mm_setcsr(0x1f80U);
+#else
+    __asm__ volatile("msr fpcr, %0" : : "r"(0ULL) : "memory");
+    __asm__ volatile("msr fpsr, %0" : : "r"(0ULL) : "memory");
+#endif
+    return true;
+}
+#endif
