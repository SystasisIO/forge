set(_FORGE_REQUESTED_COMPONENTS ${Forge_FIND_COMPONENTS})
set(_FORGE_ALL_REQUESTED FALSE)

if("crypto" IN_LIST _FORGE_REQUESTED_COMPONENTS)
   message(
      FATAL_ERROR
      "Forge crypto component was removed; request the required crypto_core, "
      "crypto_digest, crypto_symmetric, crypto_asymmetric_values, "
      "crypto_asymmetric, crypto_pki, crypto_math, crypto_bls_values, "
      "crypto_bls or crypto_bn256 components"
   )
endif()

macro(_forge_add_component component)
   if(NOT "${component}" IN_LIST _FORGE_COMPONENTS)
      list(APPEND _FORGE_COMPONENTS "${component}")

      if("${component}" STREQUAL "exceptions")
         _forge_add_component(core)
      elseif("${component}" STREQUAL "reflect")
         _forge_add_component(core)
      elseif("${component}" STREQUAL "schema")
         _forge_add_component(exceptions)
         _forge_add_component(reflect)
      elseif("${component}" STREQUAL "variant")
         _forge_add_component(chrono)
         _forge_add_component(core)
         _forge_add_component(reflect)
      elseif("${component}" STREQUAL "raw")
         _forge_add_component(core)
         _forge_add_component(exceptions)
         _forge_add_component(reflect)
         _forge_add_component(variant)
      elseif("${component}" STREQUAL "db_ids")
         _forge_add_component(raw)
         _forge_add_component(variant)
      elseif("${component}" STREQUAL "compression")
         _forge_add_component(exceptions)
      elseif("${component}" STREQUAL "chain_core")
         _forge_add_component(exceptions)
         _forge_add_component(raw)
         _forge_add_component(crypto_digest)
      elseif("${component}" STREQUAL "chain_savanna_values")
         _forge_add_component(crypto_bls)
         _forge_add_component(crypto_digest)
         _forge_add_component(raw)
         _forge_add_component(variant)
      elseif("${component}" STREQUAL "chain_protocol")
