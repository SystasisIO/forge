@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
set(Forge_BUILT_WITH_ROCKSDB @FORGE_HAS_ROCKSDB@)
set(Forge_BUILT_WITH_MDBX @FORGE_HAS_MDBX@)
set(Forge_BUILT_WITH_TUI @FORGE_HAS_TUI@)
set(Forge_BUILT_WITH_TOOLING @FORGE_ENABLE_TOOLING@)
set(Forge_BUILT_WITH_PORTABLE_VERIFIED_CLIENT @FORGE_HAS_PORTABLE_VERIFIED_CLIENT@)
set(Forge_BUILD_PROFILE "@FORGE_BUILD_PROFILE@")

set(
