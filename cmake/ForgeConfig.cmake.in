         _forge_add_component(raw)
         _forge_add_component(variant)
      elseif("${component}" STREQUAL "vm_wasm_interpret")
         _forge_add_component(exceptions)
      elseif("${component}" STREQUAL "tooling_testing")
         if(NOT Forge_BUILT_WITH_TOOLING)
            set(Forge_tooling_testing_FOUND FALSE)
            set(Forge_NOT_FOUND_MESSAGE "Forge tooling_testing component requires Forge built with tooling")
         else()
            _forge_add_component(asio)
            _forge_add_component(chain_protocol)
            _forge_add_component(codec_hex)
            _forge_add_component(crypto_asymmetric)
            _forge_add_component(crypto_bls)
            _forge_add_component(crypto_bn256)
            _forge_add_component(crypto_digest)
            _forge_add_component(crypto_math)
            _forge_add_component(db_core)
