         _forge_add_component(crypto_asymmetric_values)
         _forge_add_component(crypto_asymmetric)
         _forge_add_component(crypto_bls)
         _forge_add_component(crypto_digest)
      elseif("${component}" STREQUAL "chain_transaction")
         _forge_add_component(chain_protocol)
         _forge_add_component(crypto_signer)
      elseif("${component}" STREQUAL "chain_quorum")
         _forge_add_component(exceptions)
      elseif("${component}" STREQUAL "chain_fork")
         _forge_add_component(exceptions)
      elseif("${component}" STREQUAL "chain_savanna")
